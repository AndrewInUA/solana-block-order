# Copy to .env and fill in. .env is gitignored. Keys never belong in the repo.
# Nothing here is required for a dry run. A dry run sends nothing and spends nothing.

# --- RPC ---
# A mainnet RPC. The public endpoint rate-limits hard; use your own for a live run.
RPC_URL=https://api.mainnet-beta.solana.com
# Optional second RPC used only for sending in a live run (can equal RPC_URL).
SEND_RPC_URL=

# --- Safety ---
# Dry run is the default. Live sending happens only when this is exactly "true".
LIVE=false
# Hard fee cap for a whole live run, in SOL. The code refuses to cross it.
FEE_CAP_SOL=0.05

# --- Funding key (live runs only) ---
# The fee payer that funds the ephemeral signers. Supply ONE of these.
# A path is mounted read-only into the container as a volume; it is never copied in.
FUNDING_KEYPAIR_PATH=/keys/funding.json
# Or a base58 secret key as a string (less safe; prefer the path).
FUNDING_KEYPAIR_B58=

# --- Optional client classification ---
# validators.app token enriches client/fork identification. Falls back to the
# gossip version string and config/overrides.json when absent.
VALIDATORS_APP_TOKEN=

# --- Experiment knobs (safe defaults; override per run) ---
# Comma-separated compute-unit prices in micro-lamports per CU for the priority test.
PRIORITY_LADDER=0,1000,5000,20000,50000,100000,250000,500000
# Signers per leader window (one fee payer each, to avoid write-lock serialisation).
SIGNERS_PER_WINDOW=8
# How many leader windows to target per validator.
WINDOWS_PER_VALIDATOR=3
# Compute-unit limit requested per transaction.
CU_LIMIT=10000
